# ── MVA 模型网关配置 ──
# 图像供应商：local（零 Key，Pillow 占位画面）| openai（任意 OpenAI 兼容厂商）| sd（本地 SD WebUI）| mock-openai（自测假厂商）
MVA_IMAGE_PROVIDER=local

# 用 openai 时填这三项即可（换厂商只改这里，代码零改动）：
#   OpenAI       https://api.openai.com/v1                          gpt-image-1
#   通义万相      https://dashscope.aliyuncs.com/compatible-mode/v1   wanx2.1-t2i-turbo
#   火山方舟豆包  https://ark.cn-beijing.volces.com/api/v3            doubao-seedream-3-0-t2i
#   硅基流动      https://api.siliconflow.cn/v1                       Kwai-Kolors/Kolors
MVA_IMAGE_BASE_URL=
MVA_IMAGE_API_KEY=
MVA_IMAGE_MODEL=gpt-image-1
MVA_IMAGE_TIER=B

# 本地 Stable Diffusion（AUTOMATIC1111 / SD.Next 的 --api 模式）
MVA_SD_BASE_URL=http://127.0.0.1:7860
MVA_SD_MODEL=sd_xl_base_1.0

# ── LLM：文案 / 分镜 / 提示词编译（OpenAI 兼容 chat completions）──
#   none 表示不接（文案/分镜保持规则版兜底）；openai 表示任意 OpenAI 兼容厂商
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   DeepSeek  https://api.deepseek.com/v1                        deepseek-chat
#   火山方舟  https://ark.cn-beijing.volces.com/api/v3             doubao-1-5-pro-32k
MVA_LLM_PROVIDER=none
MVA_LLM_BASE_URL=
MVA_LLM_API_KEY=
MVA_LLM_MODEL=qwen-plus
MVA_LLM_TIER=B

# ── 视频生成（i2v / t2v，异步任务：submit → task_id → 轮询 → video_url）──
#   none 表示不接（video 节点回退为本地静图动效）；
#   dashscope 走阿里云 /services/aigc/video-generation/video-synthesis
MVA_VIDEO_PROVIDER=none
MVA_VIDEO_BASE_URL=https://dashscope.aliyuncs.com/api/v1
MVA_VIDEO_API_KEY=
MVA_VIDEO_MODEL=wan2.2-i2v-flash
MVA_VIDEO_RESOLUTION=1080P
MVA_VIDEO_POLL_INTERVAL_S=5
MVA_VIDEO_TIMEOUT_S=900
# i2v 需要厂商能访问到首帧：留空 → 本地产物转 base64 传给厂商；
# 若你把产物放到 CDN/公网，填这里改成公网 URL（如 https://cdn.example.com）
MVA_VIDEO_PUBLIC_ASSET_BASE=

# 价格表（¥），用于成本估算与账单，不写死在代码里
MVA_PRICE_LOCAL=0.0
MVA_PRICE_OPENAI=0.06
MVA_PRICE_SD=0.0
MVA_PRICE_VIDEO_SEC=0.45
MVA_PRICE_LLM_IN_1K=0.002
MVA_PRICE_LLM_OUT_1K=0.008

# 重试/降级
MVA_MAX_RETRIES=3
MVA_REQUEST_TIMEOUT_S=180
MVA_DEGRADE=1

# 服务
MVA_API_HOST=127.0.0.1
MVA_API_PORT=8010
MVA_DATA_DIR=.mva-assets
MVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
